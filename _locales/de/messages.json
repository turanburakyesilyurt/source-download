  "guideSecGettingStartedContent": {
    "message": "Klicken Sie in der DevTools-Symbolleiste auf den Reiter <strong>Source Download</strong> (drücken Sie <kbd>F12</kbd> / <kbd>Strg</kbd>+<kbd>Umschalt</kbd>+<kbd>I</kbd>). Chrome erlaubt es Erweiterungen nicht, DevTools automatisch zu öffnen. Das Symbol-Popup ermöglicht die Auswahl der Kategorien für den Zähler. Das Sonnen-/Mond-Symbol sperrt unabhängig von Chrome ein helles oder dunkles Design."
  },
  "guideSecCategoriesContent": {
    "message": "Die vertikalen Reiter links gruppieren jede Ressource nach Typ: Bilder, Videos, Audio, Untertitel, Dokumente, Schriftarten, Quellcode-Karten, WASM, SVG, APIs und mehr. Jeder Reiter zeigt einen Live-Zähler. Beim Wechsel werden Filter zurückgesetzt."
  },
  "guideSecSearchFiltersContent": {
    "message": "Die Suchleiste filtert nach Name, URL, Typ, Alt-Text oder Titel. Umschließen Sie Ihre Abfrage mit <kbd>/…/</kbd> für reguläre Ausdrücke, z. B. <code>/\\.(png|jpg)$/</code>. Darunter passt sich die Filterleiste dynamisch an die jeweilige Kategorie an."
  },
  "guideSecGridViewContent": {
    "message": "Wechseln Sie mit den Schaltflächen neben der Suchleiste zwischen kompakter Rasteransicht und detaillierter Listenansicht. Ihre Auswahl bleibt sitzungsübergreifend gespeichert."
  },
  "guideSecInspectContent": {
    "message": "Klicken Sie auf eine Ressource, um sie im Inspektionsbereich rechts zu öffnen. Jede Datei wird als eigener Tab geöffnet. Es stehen spezialisierte Viewer für Medien, Schriftarten, Code und APIs bereit."
  },
  "guideSecDownloadingContent": {
    "message": "<strong>Ansicht herunterladen</strong> speichert alle sichtbaren Ressourcen als ZIP. <strong>Ausgewählte herunterladen</strong> lädt nur markierte Elemente. <strong>Alle herunterladen</strong> erfasst alle Ressourcen in einem strukturierten ZIP."
  },
  "guideSecLightboxContent": {
    "message": "Die Zoom-Taste öffnet Medien in einer Vollbild-Lightbox mit Verschieben per Maus, Zoom per Rad oder Tastatur (<kbd>+</kbd>/<kbd>-</kbd> Zoom, <kbd>0</kbd> Zurücksetzen, <kbd>Esc</kbd> Schließen)."
  },
  "guideSecTextTablesContent": {
    "message": "<p>Die Kategorie <strong>Text</strong> ist eine lesbare Live-Kopie der Seite in DOM-Reihenfolge.</p><p>Das <strong>Abfragefeld</strong> unterstützt Enthält, Regex, CSS-Selektoren und XPath direkt auf dem DOM.</p><p>Der <strong>Lesemodus</strong> blendet Tags aus. Tabellen erfassen eine Snapshot-Historie. Exportieren Sie als TXT, Markdown oder mehrseitige XLSX-Arbeitsmappen.</p>"
  },
  "guideSecCaptionsContent": {
    "message": "WebVTT-, SRT- und TTML-Dateien landen in einem eigenen Untertitel-Tab, getrennt von Dokumenten."
  },
  "guideSecSourceMapsContent": {
    "message": "<code>.map</code>-Dateien und JSON-Quellcode-Karten werden unter Quellcode-Karten mit Formatierung übersichtlich zusammengefasst."
  },
  "guideSecDupesContent": {
    "message": "Im Reiter Bilder werden identische Dateien über Byte-Hashes erkannt. Ein Duplikate-Filter verhindert doppelte Downloads."
  },
  "guideSecVideoHlsContent": {
    "message": "Nicht nativ abspielbare Streams (HLS, DASH) zeigen eine Ausweichanzeige. HLS-Segmente können direkt im Panel zusammengeführt werden."
  },
  "guideSecPowerTipsContent": {
    "message": "Dynamische API-Antworten werden nicht per URL dedupliziert, sodass Sie wiederholte Anfragen lückenlos analysieren können."
  },
